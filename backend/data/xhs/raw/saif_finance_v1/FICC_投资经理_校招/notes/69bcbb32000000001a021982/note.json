  "lastUpdateTime": 1773976515000,
  "user": {
    "xsecToken": "ABiKscp2t8qZfCSWb43RIlUm5VkUbyE_wfn-u0_QKYs1Q=",
    "userId": "606fa74e00000000010038f0",
    "nickname": "是令可",
