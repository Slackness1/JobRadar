# Python cache
__pycache__/
*.py[cod]

# Virtual environments (dirs and symlinks)
.venv
.venv/
venv
venv/

# Environment files
.env
.env.*

# Local editor/agent state
.claude/
.opencode/

# Test/build caches
.pytest_cache/
.mypy_cache/

# Frontend artifacts
frontend/node_modules/
frontend/dist/
resume-copilot-web/node_modules/
resume-copilot-web/.next/

# Local database/data files
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.bak
backend/data/*.bak.*
backend/data/*.json
!backend/data/ground_truth_companies_v1.json
backend/data/browser_sessions/
backend/data/validation_reports/
backend/data/_secrets/
backend/data/intel_cache/
backend/data/narrative_cache/
devnull

# Runtime data exports
data/exports/

# Intermediate runtime output from scripts (chat logs, JSON snapshots, MD reports)
# generated by demo_*.py / eval_full_loop/*.py — re-generatable, large, noisy
backend/scripts/_out/

# Temp/misc files
head
tools/

# OS/editor
.DS_Store
Thumbs.db


# Git worktrees for isolated branch review
.worktrees/

# Bundled PDF fonts (fetched by scripts/install_pdf_fonts.sh)
backend/app/services/resume_copilot/fonts/*.ttf
backend/app/services/resume_copilot/fonts/*.otf

# Podcast knowledge-base raw + derived data (re-generatable via scripts/podcast_pass*.py)
# Keep _processed/term_dict.json — it's the curated dictionary, small and hand-edited.
backend/data/podcasts/transcripts/
backend/data/podcasts/transcripts_raw/
backend/data/podcasts/_meta/
backend/data/podcasts/_logs/
backend/data/podcasts/_processed/_debug/
backend/data/podcasts/_processed/episode_summaries.jsonl
backend/data/podcasts/_processed/insights.jsonl
backend/data/podcasts/_processed/insights_dedup.jsonl

# XHS pipeline outputs (re-generatable from raw via scripts/xhs_pass1/2/3)
# Raw csv 是数据所有者的,默认入仓由所有者决定;这里只屏蔽派生输出。
backend/data/xhs/_processed/_debug/
backend/data/xhs/_processed/insights.jsonl
backend/data/xhs/_processed/insights_dedup.jsonl
backend/data/xhs/_processed/notes_clean.jsonl
backend/data/xhs/_processed/notes_dropped.jsonl

# Private docs (SAIF 沟通细节 / 老师反馈 / 学生名单 等敏感文档)
